{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "招聘 RAG：数据库",
      "type": "shell",
      "command": "docker compose up -d --wait",
      "problemMatcher": []
    },
    {
      "label": "招聘 RAG：后端",
      "type": "shell",
      "command": "& '${workspaceFolder}/.venv/Scripts/python.exe' -m uvicorn main:app --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "招聘 RAG：前端",
      "type": "shell",
      "command": "npm.cmd run dev -- --hostname 127.0.0.1",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "招聘 RAG：启动全部",
      "dependsOn": ["招聘 RAG：数据库", "招聘 RAG：后端", "招聘 RAG：前端"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
