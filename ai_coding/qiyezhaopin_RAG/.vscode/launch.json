{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "导读 1：离线观察岗位与技能匹配",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/tools/inspect_seed.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "导读 2：后端断点调试（8001）",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": ["main:app", "--host", "127.0.0.1", "--port", "8001"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONIOENCODING": "utf-8" }
    }
  ]
}
