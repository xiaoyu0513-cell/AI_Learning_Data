# 复制本文件为 .env 并填入你的 Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# HuggingFace 镜像（国内下载 bge 模型用，代码内有兜底默认值）
HF_ENDPOINT=https://hf-mirror.com

# 可选：覆盖连接配置（默认值见 config.py）
# NEO4J_URI=bolt://localhost:7687
# NEO4J_PASSWORD=recruitment-rag
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# CrossEncoder 默认关闭；启用前下载 BAAI/bge-reranker-base 到本机模型缓存。
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RETRIEVAL_CANDIDATES=20
REQUEST_TIMEOUT_SECONDS=60
RETRIEVAL_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
CONTEXT_MAX_CHARS=18000

# 默认为 backend/runtime，包含本地会话/索引清单/trace，不提交 Git。
# STATE_DIR=D:/qiyezhaopin_RAG/backend/runtime

# 可选 Langfuse（未配置时只记录本地元数据 trace）。
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
